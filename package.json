{
  "name": "qb-server-boilerplate",
  "description": "A boilerplate for REST API server based on Express, MongoDB, and ES6/ES7 features.",
  "version": "1.0.0",
  "author": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": ""
  },
  "overrides": {
    "axios": "^1.7.0",
    "cookie": "^0.7.0",
    "debug": "^4.3.7",
    "on-headers": "^1.0.2",
    "markdown-it": "^14.0.0"
  },
  "engines": {
    "node": ">= 6.10",
    "npm": ">= 3.10",
    "yarn": ">=0.20.3"
  },
  "main": "./src/index.js",
  "keywords": [
    "express",
    "es6",
    "es7",
    "rest",
    "api",
    "boilerplate",
    "mongodb",
    "node",
    "javascript",
    "pm2",
    "babel",
    "nps",
    "commitizen",
    "semantic-release",
    "prettier",
    "lint-staged",
    "webpack2"
  ],
  "license": "MIT",
  "lint-staged": {
    "src/**/*.js": [
      "yarn prettier",
      "git add"
    ]
  },
  "scripts": {
    "build": "nps build",
    "start": "nps",
    "dev": "cross-env DOTENV_CONFIG_PATH=.env nodemon -r dotenv/config ./src/index.js",
    "dev:debug": "nps dev.debug",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest __tests__/unit __tests__/services __tests__/utils __tests__/middlewares",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest __tests__/integration",
    "test:controllers": "NODE_OPTIONS='--experimental-vm-modules' jest __tests__/controllers",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --ci --coverage --runInBand",
    "test:verbose": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose",
    "migrate:tenant": "node scripts/migrations/add-tenant-foreign-keys.js",
    "prettier": "prettier --write '{src,__{tests,mocks}__}/**/*.js'",
    "precommit": "nps lintStaged && npm run test",
    "lint": "nps lint",
    "lint:fix": "nps lint.fix",
    "db:seeds-user": "nps db.seedsUser",
    "db:seeds-clear": "nps db.seedsClearUser",
    "db:seeds-clear-user": "nps db.seedsClear",
    "doc": "nps doc",
    "doc:deploy": "nps doc.deploy",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:dev": "cross-env DOTENV_CONFIG_PATH=.env pm2 start ecosystem.config.cjs --env development",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop draftq-prod",
    "pm2:restart": "pm2 restart draftq-prod",
    "pm2:reload": "pm2 reload draftq-prod",
    "pm2:delete": "pm2 delete draftq-prod",
    "pm2:logs": "pm2 logs draftq-prod",
    "pm2:monit": "pm2 monit",
    "seed:admin": "npx cross-env DOTENV_CONFIG_PATH=.env node -r dotenv/config scripts/seed-admin.js"
  },
  "devDependencies": {
    "ajv": "^6.0.0",
    "ajv-keywords": "^3.0.0",
    "apidoc": "^0.29.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^2.3.0",
    "express-status-monitor": "^1.3.4",
    "husky": "^0.14.3",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.5",
    "morgan": "^1.8.1",
    "nodemon": "^3.0.0",
    "nps": "^5.7.1",
    "nps-utils": "^1.0.2",
    "prettier": "^1.6.1",
    "semantic-release": "^25.0.1",
    "source-list-map": "2.0.0",
    "supertest": "^6.3.4",
    "webpack": "^5.102.1",
    "webpack-node-externals": "^1.6.0",
    "webpack-sources": "1.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.17.1",
    "chalk": "^3.0.0",
    "compression": "^1.7.0",
    "cors": "^2.8.4",
    "dotenv": "^16.0.0",
    "express": "^4.21.0",
    "express-winston": "^2.4.0",
    "helmet": "^8.0.0",
    "http-status": "^1.0.1",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.3.0",
    "method-override": "^2.3.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pm2": "^6.0.13",
    "pretty-error": "^2.1.1",
    "semver": "^7.7.3",
    "sequelize": "^6.37.0",
    "slug": "^0.9.1",
    "sqlite3": "^5.1.7",
    "winston": "^2.3.1"
  }
}
